# Scope repository to the main project folder
/*
!/.gitignore
!/README.md
!/ai-interview-assistant/
!/AI/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets and environment files
**/.env
**/.env.*
!**/.env.example

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/.coverage
**/htmlcov/

# Node / frontend
**/node_modules/
**/dist/
**/.npm/
**/.pnpm-store/

# Misc build artifacts
**/coverage/
**/*.sqlite3
**/*.db

# GitHub Workflows
.github/workflows/
