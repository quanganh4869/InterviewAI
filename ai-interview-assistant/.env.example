# Local Docker defaults
POSTGRES_DB=AIinterview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_SERVER=database
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

READ_ONLY_POSTGRES_DB=AIinterview
READ_ONLY_POSTGRES_USER=postgres
READ_ONLY_POSTGRES_PASSWORD=123456
READ_ONLY_POSTGRES_SERVER=database
READ_ONLY_POSTGRES_PORT=5432
READ_ONLY_POSTGRES_SSL_MODE=disable

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123456
PGADMIN_PORT=5050

VITE_API_BASE_URL=http://localhost:8000

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
INTERVIEW_MAX_QUESTIONS=6
INTERVIEW_RECORDING_PREFIX=interviews

# Supabase Postgres example for deployment/local testing with hosted DB.
# Copy these values from Supabase Project Settings -> Database -> Connection string.
# Use the Transaction pooler host if your hosting provider has unstable IPv6 support.
#
# POSTGRES_SERVER=aws-0-ap-southeast-1.pooler.supabase.com
# POSTGRES_PORT=6543
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_PASSWORD=<supabase-database-password>
# POSTGRES_SSL_MODE=require
#
# READ_ONLY_POSTGRES_SERVER=aws-0-ap-southeast-1.pooler.supabase.com
# READ_ONLY_POSTGRES_PORT=6543
# READ_ONLY_POSTGRES_DB=postgres
# READ_ONLY_POSTGRES_USER=postgres.<project-ref>
# READ_ONLY_POSTGRES_PASSWORD=<supabase-database-password>
# READ_ONLY_POSTGRES_SSL_MODE=require
