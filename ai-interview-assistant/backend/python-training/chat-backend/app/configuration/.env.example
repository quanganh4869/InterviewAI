# General project settings and487679981454-ej98cv28uh91il0hosapjmigsb6pvdoe.apps.googleusercontent.com CORS configuration
ENVIRONMENT='develop'
PROJECT_NAME='Chat Backend Service'

BACKEND_CORS_ORIGINS=["*"]
BACKEND_CORS_METHODS=


# PostgreSQL database connection and initialization settings.
# Local Docker uses POSTGRES_SERVER=database.
# Supabase uses the host/user/password from Project Settings -> Database.
POSTGRES_SERVER=database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=AIinterview
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
DB_ECHO=false
DB_INIT=false

READ_ONLY_POSTGRES_SERVER=database
READ_ONLY_POSTGRES_USER=postgres
READ_ONLY_POSTGRES_PASSWORD=123456
READ_ONLY_POSTGRES_DB=AIinterview
READ_ONLY_POSTGRES_PORT=5432
READ_ONLY_POSTGRES_SSL_MODE=disable

#
APP_SECRET_ROTATION_KEY_MAPPING=
APP_SECRET_CURRENT_VERSION=


# Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage
STORAGE_STRATEGY=local
UPLOAD_DIR=uploads
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=interviewai
CLOUDFLARE_R2_PRESIGNED_EXPIRES_SECONDS=900
CLOUDFLARE_R2_PRESIGNED_GET_EXPIRES_SECONDS=600
DOCUMENT_CV_PREFIX=
DOCUMENT_JD_PREFIX=
INTERVIEW_RECORDING_PREFIX=interviews

# AI Interview
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
LOCAL_WHISPER_URL=http://localhost:8001/api/v1/stt/transcribe
INTERVIEW_MAX_QUESTIONS=6

# CV Parser
CV_PARSE_MAX_EXTRACTED_CHARS=12000
CV_PARSE_MAX_HIGHLIGHTS=8
CV_PARSE_MAX_DIAGNOSTICS_IN_ERROR=12
CV_OCR_ENABLED=true
CV_OCR_LANG=vie+eng
CV_OCR_DPI=300
TESSERACT_CMD=
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
CV_PARSE_LEADING_BULLET_PATTERN=^[\s\-\*\>\u00bb\u2022\u2023\u2043\u2219\u25aa\u25ab\u25cf\u25a0\u25e6\u00b7\uf0a7\uf0b7\uf071]+
CV_PARSE_LEADING_SYMBOL_RUN_PATTERN=^[^\w]+(?=\w)

# Match Scoring
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
CV_JD_EMBEDDING_ENABLED=true
WEIGHT_SEMANTIC=0.5
WEIGHT_SKILL=0.3
WEIGHT_EXPERIENCE=0.2

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AI Interview Assistant"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
